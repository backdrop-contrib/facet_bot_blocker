<?php

/**
 * @file
 * Facet bot blocker module
 */

/**
 * Implements hook_menu().
 */
function facet_bot_blocker_menu() {
  $items['admin/config/system/facet-bot-blocker'] = [
    'title' => 'Facet Bot Blocker',
    'page callback' => 'backdrop_get_form',
    'page arguments' => ['facet_bot_blocker_settings'],
    'access arguments' => ['administer facet blot blocker'],
  ];
  $items['admin/reports/facet-bot-blocker'] = [
    'title' => 'Facet Bot Blocker',
    'page callback' => 'facet_bot_blocker_dashboard',
    'access arguments' => ['access facet bot blocker dashboard'],
  ];

  return $items;
}

/**
 * Implements hook_permission().
 */
function facet_bot_blocker_permission() {
  $permissions['administer facet bot blocker'] = [
    'title' => t('Administer Facet Bot Blocker settings'),
    'description' => t('Allow users to modify the settings of the Facet Bot Blocker module.'),
    'restrict access' => TRUE,
    'warning' => t('Provides access to settings that should generally be restricted to site administrators.'),
  ];
  $permissions['access facet bot blocker dashboard'] = [
    'title' => t('Access Facet Bot Blocker dashboard'),
    'description' => t('Allow users to view the dashboard reports page for Facet Bot Blocker.'),
  ];
  $permissions['bypass facet bot blocker'] = [
    'title' => 'Bypass Facet Bot Blocker blocks',
    'description' => t('Allow users to bypass the block generated by Facet Bot Blocker.'),
  ];

  return $permissions;
}

/**
 * Menu callback: dashboard
 *
 * Assembles a report page showing metrics of the Facet bot blocker.
 */
function facet_bot_blocker_dashboard() {
  // cache counters.
  // Get the configured facet limit.
  $config = config('facet_bot_blocker.settings');

  $limit = $config->get('limit');

  // Retrieve counters and data from cache.
  $blocked_cache = cache_get('facet_bot_blocker.blocked_requests');
  $allowed_cache = cache_get('facet_bot_blocker.allowed_requests');
  $last_blocked_cache = cache_get('facet_bot_blocker.last_blocked_request');
  $start_time_cache = cache_get('facet_bot_blocker.metrics_start_time');

  // Extract data or use defaults if cache entries are missing.
  $blocked_requests = $blocked_cache ? $blocked_cache->data : 0;
  $allowed_requests = $allowed_cache ? $allowed_cache->data : 0;
  $last_blocked = $last_blocked_cache ? $last_blocked_cache->data : [];
  $metrics_start_time = $start_time_cache ? $start_time_cache->data : REQUEST_TIME;

  // Compute "time since metrics started".
  $time_since_start = REQUEST_TIME - $metrics_start_time;
  $time_since_string = round($time_since_start / 3600, 2) . ' hours';

  if ($blocked_requests === 0) {
    $percent = '0%';
  } elseif ($allowed_requests == 0) {
    $percent = '100%';
  } else {
    $percent = (float) $blocked_requests / ((float) $blocked_requests + (float) $allowed_requests);
    $percent = sprintf("%.2f%%", $percent * 100);
  }

  // Prepare a small table. You can theme this however you like.
  $rows = [];
  $rows[] = [
    t('Current facet limit'),
    $limit,
  ];
  $rows[] = [
    t('Blocked requests'),
    $blocked_requests,
  ];
  $rows[] = [
    t('Allowed requests'),
    $allowed_requests,
  ];
  $rows[] = [
    t('Percent blocked'),
    $percent,
  ];
  $rows[] = [
    t('Time since metrics started'),
    $time_since_string,
  ];

  // If you tracked last blocked request data, include it:
  if (!empty($last_blocked)) {
    $ip = $last_blocked['ip'] ?? t('Unknown');
    $path = $last_blocked['path'] ?? t('Unknown');
    $ua = $last_blocked['user_agent'] ?? t('Unknown');
    $rows[] = [
      t('Last blocked IP'),
      $ip,
    ];
    $rows[] = [
      t('Last blocked path'),
      $path,
    ];
    $rows[] = [
      t('Last blocked User Agent'),
      $ua,
    ];
  }

  $build = t('<p>Metrics are tracked only if enabled in the Facet Bot Blocker settings. Disable tracking if it impacts performance.</p>');
  $build .= theme('table', [
    'header' => [
      t('Metric'),
      t('Value'),
    ],
    'rows' => $rows,
  ]);

  return $build;
}

/**
 * Settings form
 *
 * @ingroup forms
 */
function facet_bot_blocker_settings($form, &$form_state) {
  $config = config('facet_bot_blocker.settings');
  $form['#config'] = 'facet_bot_blocker.settings';
  $form['limit'] = [
    '#type' => 'number',
    '#title' => t('Facet parameter limit'),
    '#description' => t('Block requests if a facet query parameter with this index is found, e.g., <code>f[@limit]</code>. Default is 5.'),
    '#default_value' => $config->get('limit') ?? 5,
    '#min' => 1,
    '#required' => TRUE,
  ];

  $form['pretty_paths'] = [
    '#type' => 'details',
    '#summary' => t('Facet Pretty Paths'),
    '#open' => FALSE,
    '#access' => module_exists('facetapi_pretty_paths'),
  ];
  $form['pretty_paths']['help'] = [
    '#markup' => t('If using !facet_pretty_paths module, the facet query parameters are divided by "slashes" rather than <code>f=</code>. For example, <code>search/url/segment1/segment2/</code> where each segment looks like <code>alias/value</code>. It requires checking the number of segments for specific paths.', ['!facet_pretty_paths' => l('FacetAPI Pretty Paths', 'https://backdropcms.org/project/facetapi_pretty_paths')]),
  ];
  $form['pretty_paths']['base_paths'] = [
    '#type' => 'textarea',
    '#title' => t('Facet base paths (one per line)'),
    '#description' => t('Check the number of "pretty path" facets on the following base paths. If blank then no paths will be checked. The base path is removed when counting the paths so only segments are counted. E.g. if the base path entered here is <code>library/search</code> (do not include a trailing slash) then this will be stripped from the path <code>library/search/theme/one/theme/two/theme/three</code>. It will calculate three facet parameters based on the path.'),
    '#default_value' => implode("\n", $config->get('base_paths') ?? []),
  ];

  $form['return_gone'] = [
    '#type' => 'checkbox',
    '#title' => t('Return 410 Gone instead of 403 Forbidden'),
    '#default_value' => $config->get('return_gone') ?? FALSE,
    '#description' => t('If enabled, blocked facet requests will return HTTP 410 Gone instead of 403 Forbidden.'),
  ];

  $form['track_blocks'] = [
    '#type' => 'checkbox',
    '#title' => t('Track blocked requests'),
    '#default_value' => $config->get('track_blocks') ?? FALSE,
    '#description' => t('<em>Warning: may impact performance.</em> If enabled, blocked facet requests will be tracked in the cache. If not using !memcache or !redis to store cache in memory, Backdrop will store cache in the database which may impact performance on sites with heavy traffic.', ['!memcache' => l('Memcache', 'https://backdropcms.org/project/memcache'), '!redis' => l('Redis', 'https://github.com/backdrop-contrib/redis')]),
  ];

  $form['message'] = [
    '#type' => 'textarea',
    '#title' => t('Custom blocked message'),
    '#description' => t('HTML message displayed when a request is blocked. The check happens early in the boot process when translations are not yet available.'),
    '#default_value' => $config->get('message') ?? '<h1>Excessive crawling detected</h1><p>We have blocked your request.</p>',
  ];

  $form['actions']['#type'] = 'actions';
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Save configuration'),
  );

  return $form;
}

/**
 * Submit handler for bot_blocker_settings().
 */
function facet_bot_blocker_settings_submit($form, &$form_state) {
  form_state_values_clean($form_state);
  $config = config('facet_bot_blocker.settings');

  // Base paths → trimmed array.
  $base_paths = array_filter(array_map('trim', explode("\n", $form_state['values']['base_paths'])));

  $config
    ->set('return_gone', (bool) $form_state['values']['return_gone'])
    ->set('track_blocks', (bool) $form_state['values']['track_blocks'])
    ->set('message', $form_state['values']['message'])
    ->set('base_paths', $base_paths)
    ->set('limit', (int) ($form_state['values']['limit'] ?? 5))
    ->save();

  backdrop_set_message(t('Facet Bot Blocker configuration saved.'));
}

/**
 * Implements hook_boot().
 */
function facet_bot_blocker_boot() {
  if (facet_bot_blocker_bypass()) {
    return;
  }

  // Retrieve config from cache or config system.
  $config = config('facet_bot_blocker.settings');

  // Determine if we should use cache for storing config values. Useful if
  // traffic is low or if using memcache or redis.
  $fast_cache = (module_exists('memcache') || module_exists('redis'));

  $track_blocks = $config->get('track_blocks') ?? TRUE;

  // The limit.
  $limit_cache = cache_get('facet_bot_blocker.limit');
  if ($fast_cache && $limit_cache) {
    $limit = $limit_cache->data;
  } else {
    $limit = $config->get('limit');
    // Fallback if config is missing:
    if (empty($limit)) {
      $limit = 1;
    }

    // If we should cache it:
    if ($fast_cache) {
      cache_set('facet_bot_blocker.limit', $limit);
    }
  }

  // -- Return Gone? --
  $gone_cache = cache_get('facet_bot_blocker.return_gone');
  if ($fast_cache && $gone_cache) {
    $return_gone = $gone_cache->data;
  } else {
    $return_gone = (bool) $config->get('return_gone');
    if ($fast_cache) {
      cache_set('facet_bot_blocker.return_gone', $return_gone);
    }
  }

  // Blocked Message.
  $message_cache = cache_get('facet_bot_blocker.message');
  if ($fast_cache && $message_cache) {
    $blocked_message = $message_cache->data;
  } else {
    $blocked_message = $config->get('message') ?? '<h1>Excessive crawling detected</h1><p>We have blocked your request.</p>';

    if ($fast_cache) {
      cache_set('facet_bot_blocker.message', $blocked_message);
    }
  }

  // Check if the request is "over the limit" => blocked.
  $is_blocked = FALSE;
  if (isset($_GET['f']) && is_array($_GET['f']) && count($_GET['f']) > $limit) {
    $is_blocked = TRUE;
  }

  // If using FacetAPI Pretty Paths module, check the nested directories instead
  // of the facet parameters.
  $base_paths = $config->get('base_paths') ?? [''];
  foreach ($base_paths as $base_path) {
    if (isset($_GET['q']) && str_contains($_GET['q'], $base_path)) {
      $path_to_check = str_replace(rtrim($base_path, '/'), '', $_GET['q']);
      preg_match_all('/\//', $path_to_check, $matches);
      // Count the number of matches.
      // We double the limit, because it takes 2 slashes to equal one
      // "f" parameter.
      if (count($matches[0]) > ($limit * 2)) {
        $is_blocked = TRUE;
      }
    }
  }

  // If blocked, build and set a response. Otherwise, increment "allowed"
  // counter if there's a facet param.
  if ($is_blocked) {
    $status_code = $return_gone ? '410 Gone' : '403 Forbidden';

    backdrop_add_http_header('Status', $status_code);
    print $blocked_message;
    exit();

    // Add some counters if using cache.
    if ($track_blocks) {
      // Increment blocked requests count.
      facet_bot_blocker_bump_counter('blocked_requests');

      // Save last blocked info.
      cache_set('facet_bot_blocker.last_blocked_request', [
        'ip' => ip_address(),
        'path' => request_uri(),
        'user_agent' => $_SERVER['HTTP_USER_AGENT'] ?? '',
      ]);
    }
  } elseif (!empty($_GET['f']) && $track_blocks) {
    facet_bot_blocker_bump_counter('allowed_requests');
  }
}

/**
 * Bump counter
 *
 * @param string $key
 */
function facet_bot_blocker_bump_counter(string $key) {
  $item  = cache_get("facet_bot_blocker.$key");
  $count = $item ? (int) $item->data : 0;
  cache_set("facet_bot_blocker.$key", ++$count);

  if (!cache_get('facet_bot_blocker.metrics_start_time')) {
    cache_set('facet_bot_blocker.metrics_start_time', REQUEST_TIME);
  }
}

/**
 * Check if current user can bypass the blocker.
 *
 * @return bool
 */
function facet_bot_blocker_bypass() {
  global $user;
  if ($user->uid == 1) {
    return TRUE;
  }

  static $backdrop_static_fast;
  if (!isset($backdrop_static_fast)) {
    $backdrop_static_fast['perm'] = &backdrop_static(__FUNCTION__);
  }
  $perm = &$backdrop_static_fast['perm'];
  if (!isset($perm[$user->uid])) {
    $perm[$user->uid] = [];
    foreach ($user->roles as $role) {
      $role_config = config('user.role.' . $role);
      $perm[$user->uid] += $role_config->get('permissions');
    }
  }

  if (in_array('bypass facet bot blocker', $perm[$user->uid])) {
    return TRUE;
  }
}
